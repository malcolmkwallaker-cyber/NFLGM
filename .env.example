# Approval required before enabling either switch.
NEXT_PUBLIC_ANALYTICS=off
ANALYTICS_COLLECTION=off
# Set a private random password of at least 12 characters in Netlify, never here.
ANALYTICS_DASHBOARD_TOKEN=
# Optional GA4 measurement ID. Leave unset to omit gtag.js.
# Set the real value in Netlify environment variables, then redeploy.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
